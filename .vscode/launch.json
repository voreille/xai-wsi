{
   "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
              "name": "Attach to shell script (:5678)",
              "type": "python",
              "request": "attach",
              "connect": {
                "host": "127.0.0.1",
                "port": 5678
              },
              "justMyCode": false
        }
   ]
}
